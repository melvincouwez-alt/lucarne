{
  "manifest_version": 3,
  "name": "Lucarne",
  "version": "4.1.0",
  "description": "Opens SharePoint/OneDrive documents and Outlook, Teams and Power BI pages clicked in Chrome in the Lucarne desktop windows (or in Office in the Vasistas VM).",
  "key": "",
  "permissions": [
    "webNavigation",
    "tabs",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lucarne",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon32.png"
    }
  },
  "icons": {
    "32": "icon32.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://*.sharepoint.com/*"
  ]
}
